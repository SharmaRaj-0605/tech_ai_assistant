# Any "provider:model" pair that LangChain's init_chat_model / init_embeddings understands.
# Install the matching provider package too (for example langchain-google-genai).
CHAT_MODEL=google_genai:gemini-2.0-flash
EMBEDDING_MODEL=google_genai:models/text-embedding-004
GOOGLE_API_KEY=your-key-here

# Leave empty to keep conversations in memory (lost on restart).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/chatbot

# Docker Compose only: the password for its PostgreSQL container (letters and digits are safest).
# Compose builds DATABASE_URL itself, so the line above is ignored there.
POSTGRES_PASSWORD=
# Package installed into the image for your provider, e.g. langchain-openai.
PROVIDER_PACKAGE=langchain-google-genai

# When set, every API call except /health needs an X-API-Key header with this value.
API_KEY=

# Streamlit talks to the API here.
API_URL=http://localhost:8000

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=agentic-rag-chatbot
